<!DOCTYPE html>
<html lang={assigns[:html_lang] || "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%= if posthog = TcgCheapWeb.Analytics.config(@conn) do %>
      <meta
        name="posthog"
        content={posthog.api_key}
        data-api-host={posthog.api_host}
        data-asset-host={posthog.asset_host}
      />
    <% end %>
    <.live_title default="TCG Cheap" suffix=" · TCG Cheap" phx-no-format>{assigns[:page_title]}</.live_title>
    <%= if assigns[:seo] do %>
      <TcgCheapWeb.SEO.head seo={@seo} />
    <% else %>
      <meta name="robots" content="noindex, nofollow" />
    <% end %>
    <link rel="icon" href={~p"/favicon.ico"} sizes="48x48" />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
