<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="TCG Cheap" suffix=" · TCG Cheap" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <%= if assigns[:page_title] == "Compare Pokémon prices" do %>
      {Phoenix.HTML.raw(
        "<!-- THESIS: Compare Pokémon prices quickly; keep exact identity and honest estimates available without technical clutter.\nOWN-WORLD: A warm card-shop valuation bench: bright tissue, board, ink rules, square result rows, and measurement-led type.\nSTORY: Choose Singles or Sealed products, search locally, verify the exact card and price, then view price details.\nFIRST VIEWPORT: Compact masthead, plain heading, two-button mode switch, and one direct card search.\nFORM: Card-shop valuation bench; grounded direction 7; seed ca73501c.\nFINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md\n-->"
      )}
    <% end %>
    {@inner_content}
  </body>
</html>
