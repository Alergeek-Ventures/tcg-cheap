<!DOCTYPE html>
<html lang={assigns[:html_lang] || "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%= if posthog = TcgCheapWeb.Analytics.config(@conn) do %>
      <meta
        name="posthog"
        content={posthog.api_key}
        data-proxy-paths={Jason.encode!(posthog.proxy_paths)}
      />
    <% end %>
    <.live_title default="TCG Cheap" suffix=" · TCG Cheap" phx-no-format>{assigns[:page_title]}</.live_title>
    <%= if assigns[:seo] do %>
      <TcgCheapWeb.SEO.head seo={@seo} />
    <% else %>
      <meta name="robots" content="noindex, nofollow" />
    <% end %>
    <link rel="icon" href={~p"/favicon.ico"} sizes="48x48" />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <link
      rel="preload"
      href={~p"/fonts/azeret-mono-400.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={~p"/fonts/barlow-condensed-700.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link phx-track-static rel="stylesheet" href={TcgCheapWeb.Layouts.stylesheet(@conn)} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <%!-- Product photos fade in over their blurred preview once loaded (product_image/1).
         A photo already at hand (cached, or loaded within 100 ms of appearing) shows
         at once instead, also on LiveView navigations: data-loaded="instant".
         Inline, so photos that load before app.js are caught too. --%>
    <script nonce={@conn.assigns[:csp_nonce]}>
      (() => {
        const shownAt = new WeakMap()
        const photos = node =>
          node.matches?.("img[data-progressive]") ? [node] : [...(node.querySelectorAll?.("img[data-progressive]") ?? [])]
        const mark = (img, instant) => img.setAttribute("data-loaded", instant ? "instant" : "")
        // A cached photo is ready by the next frame (a srcset one only after a microtask).
        const watch = (img, since) => {
          if (img.hasAttribute("data-loaded")) return
          shownAt.set(img, since ?? performance.now())
          requestAnimationFrame(() => img.complete && img.naturalWidth && mark(img, true))
        }
        new MutationObserver(records => {
          // LiveView may swap a photo still loading for a copy in the same patch:
          // the copy keeps the original's start.
          const loading = new Map()
          for (const {removedNodes} of records)
            for (const node of removedNodes)
              for (const img of photos(node))
                if (!img.hasAttribute("data-loaded") && shownAt.has(img)) loading.set(img.getAttribute("src"), shownAt.get(img))
          for (const {type, target, addedNodes} of records) {
            if (type === "attributes" && target.matches("img[data-progressive]")) watch(target)
            for (const node of addedNodes) photos(node).forEach(img => watch(img, loading.get(img.getAttribute("src"))))
          }
        }).observe(document.documentElement, {childList: true, subtree: true, attributeFilter: ["src", "srcset"]})
        const onDone = e => {
          if (!e.target.matches?.("img[data-progressive]") || e.target.hasAttribute("data-loaded")) return
          mark(e.target, e.type === "load" && performance.now() - (shownAt.get(e.target) ?? -Infinity) < 100)
        }
        document.addEventListener("load", onDone, true)
        document.addEventListener("error", onDone, true)
      })()
    </script>
    <noscript phx-no-curly-interpolation><style>
      img[data-progressive] { opacity: 1 !important; }
    </style></noscript>
  </head>
  <body>
    {@inner_content}
    <%= if TcgCheapWeb.Analytics.config(@conn) do %>
      <TcgCheapWeb.GuideComponents.report_form />
      <TcgCheapWeb.GuideComponents.cookie_notice />
    <% end %>
  </body>
</html>
