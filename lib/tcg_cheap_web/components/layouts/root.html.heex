<!DOCTYPE html>
<html lang={assigns[:html_lang] || "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%= if posthog = TcgCheapWeb.Analytics.config(@conn) do %>
      <meta
        name="posthog"
        content={posthog.api_key}
        data-proxy-paths={Jason.encode!(posthog.proxy_paths)}
      />
    <% end %>
    <.live_title default="TCG Cheap" suffix=" · TCG Cheap" phx-no-format>{assigns[:page_title]}</.live_title>
    <%= if assigns[:seo] do %>
      <TcgCheapWeb.SEO.head seo={@seo} />
    <% else %>
      <meta name="robots" content="noindex, nofollow" />
    <% end %>
    <link rel="icon" href={~p"/favicon.ico"} sizes="48x48" />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <link
      rel="preload"
      href={~p"/fonts/azeret-mono-400.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={~p"/fonts/barlow-condensed-700.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link phx-track-static rel="stylesheet" href={TcgCheapWeb.Layouts.stylesheet(@conn)} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <%!-- Product photos fade in over their blurred preview once loaded (product_image/1).
         Inline, so photos that load before app.js are caught too. --%>
    <script nonce={@conn.assigns[:csp_nonce]}>
      const markLoaded = e => e.target.matches?.("img[data-progressive]") && e.target.setAttribute("data-loaded", "")
      document.addEventListener("load", markLoaded, true)
      document.addEventListener("error", markLoaded, true)
    </script>
    <noscript phx-no-curly-interpolation><style>
      img[data-progressive] { opacity: 1 !important; }
    </style></noscript>
  </head>
  <body>
    {@inner_content}
    <%= if TcgCheapWeb.Analytics.config(@conn) do %>
      <TcgCheapWeb.GuideComponents.report_form />
      <TcgCheapWeb.GuideComponents.cookie_notice />
    <% end %>
  </body>
</html>
