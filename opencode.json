{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "tidewave": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "exec npx -y mcp-remote@0.16.0 \"http://localhost:$(cat .server.port 2>/dev/null || echo 4004)/tidewave/mcp\""
        ]
      },
      "buying-guide": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "exec npx -y mcp-remote@0.16.0 \"http://localhost:$(cat .server.port 2>/dev/null || echo 4004)/mcp\""
        ]
      },
      "posthog": {
        "type": "remote",
        "url": "https://mcp.posthog.com/mcp"
      },
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp"
      }
    }
  }
}
