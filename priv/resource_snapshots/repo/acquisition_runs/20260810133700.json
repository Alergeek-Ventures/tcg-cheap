      "base_filter": null,
      "check": "(status = 'running' AND finished_at IS NULL AND failure_category IS NULL) OR (status = 'succeeded' AND finished_at IS NOT NULL AND failure_category IS NULL) OR (status IN ('retryable_failure','failed','cancelled') AND finished_at IS NOT NULL AND failure_category IS NOT NULL)",
      "name": "acquisition_runs_lifecycle_invariant"
    },
    {
      "attribute": [
        "started_at",
        "finished_at"
      ],
      "base_filter": null,
