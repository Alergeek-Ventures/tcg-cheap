      "name": "sealed_products_product_type_invariant"
    },
    {
      "attribute": [
        "publication_status",
        "distribution_status"
      ],
      "base_filter": null,
      "check": "publication_status IN ('draft', 'approved', 'archived') AND distribution_status IN ('current', 'discontinued')",
      "name": "sealed_products_status_invariant"
    },
    {
      "attribute": [
        "msrp_pln",
        "msrp_currency",
        "msrp_source"
      ],
      "base_filter": null,
      "check": "((msrp_pln IS NULL AND msrp_currency = 'PLN' AND msrp_source IS NULL) OR (msrp_pln IS NOT NULL AND msrp_pln > 0 AND msrp_currency = 'PLN' AND msrp_source IS NOT NULL AND btrim(msrp_source) <> ''))",
      "name": "sealed_products_msrp_invariant"
    },
    {
      "attribute": [
        "market",
        "language",
        "officially_distributed"
      ],
      "base_filter": null,
      "check": "market = 'PL' AND language = 'en'",
      "name": "sealed_products_distribution_invariant"
    },
    {
      "attribute": [
        "publication_status",
        "approved_at",
        "archived_at"
      ],
      "base_filter": null,
      "check": "(publication_status = 'draft' AND approved_at IS NULL AND archived_at IS NULL) OR (publication_status = 'approved' AND approved_at IS NOT NULL AND archived_at IS NULL) OR (publication_status = 'archived' AND archived_at IS NOT NULL)",
      "name": "sealed_products_review_timestamps_invariant"
    },
    {
      "attribute": [
        "publication_status",
        "officially_distributed",
        "release_date"
      ],
      "base_filter": null,
      "check": "publication_status <> 'approved' OR (officially_distributed = TRUE AND release_date IS NOT NULL)",
      "name": "sealed_products_approved_completeness_invariant"
    },
    {
      "attribute": [
        "source",
        "source_id"
      ],
      "base_filter": null,
      "check": "(source IS NULL AND source_id IS NULL) OR (source IS NOT NULL AND source_id IS NOT NULL AND btrim(source) <> '' AND btrim(source_id) <> '')",
      "name": "sealed_products_source_identity_invariant"
    },
    {
      "attribute": [
        "msrp_pln",
        "msrp_currency",
        "msrp_source"
      ],
      "base_filter": null,
      "check": "msrp_pln IS NULL OR (msrp_pln <> 'NaN'::numeric AND msrp_pln <> 'Infinity'::numeric AND msrp_pln <> '-Infinity'::numeric)",
      "name": "sealed_products_msrp_finite_invariant"
    }
  ],
