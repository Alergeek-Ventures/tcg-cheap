      "check": "cardinality(set_ids) BETWEEN 1 AND 1000 AND array_position(set_ids, NULL) IS NULL AND array_to_string(set_ids, ',') ~ '^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(,[A-Za-z0-9][A-Za-z0-9._-]{0,127})*$'",
      "name": "catalogue_sync_runs_set_ids_invariant"
    },
    {
      "attribute": [
        "next_index",
        "set_ids"
      ],
      "base_filter": null,
      "check": "next_index >= 0 AND next_index <= cardinality(set_ids)",
      "name": "catalogue_sync_runs_index_invariant"
    },
    {
      "attribute": [
        "synced_sets",
        "partial_sets",
        "failed_sets",
        "excluded_sets",
        "next_index"
      ],
      "base_filter": null,
      "check": "synced_sets >= 0 AND partial_sets >= 0 AND failed_sets >= 0 AND excluded_sets >= 0 AND synced_sets + partial_sets + failed_sets + excluded_sets = next_index",
      "name": "catalogue_sync_runs_counter_invariant"
    },
    {
      "attribute": [
        "status",
        "next_index",
        "set_ids",
        "completed_at"
      ],
      "base_filter": null,
      "check": "(status = 'running' AND next_index < cardinality(set_ids) AND completed_at IS NULL) OR (status = 'completed' AND next_index = cardinality(set_ids) AND completed_at IS NOT NULL)",
      "name": "catalogue_sync_runs_lifecycle_invariant"
    },
    {
