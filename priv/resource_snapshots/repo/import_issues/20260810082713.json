      "check": "target_type IN ('catalogue','set','card')",
      "name": "import_issues_target_type_invariant"
    },
    {
      "attribute": [
        "issue_kind"
      ],
      "base_filter": null,
      "check": "issue_kind IN ('unmatched','ambiguous','malformed','failed')",
      "name": "import_issues_kind_invariant"
    },
    {
      "attribute": [
        "issue_code"
      ],
      "base_filter": null,
      "check": "issue_code IN ('malformed_response','budget','rate_limit','timeout','transport','provider_response','persistence','configuration','local_input','unknown')",
      "name": "import_issues_code_invariant"
    },
    {
      "attribute": [
        "operation",
        "stage"
      ],
      "base_filter": null,
      "check": "(operation = 'card_catalogue_sync' AND stage IN ('catalogue_fetch','catalogue_validation','set_fetch','set_validation','set_import')) OR (operation = 'card_catalogue_enrichment' AND stage IN ('set_fetch','set_validation','set_import','card_fetch','card_import'))",
      "name": "import_issues_operation_stage_invariant"
    },
    {
      "attribute": [
        "stage",
        "target_type",
        "target_key"
      ],
      "base_filter": null,
      "check": "(stage IN ('catalogue_fetch','catalogue_validation') AND target_type = 'catalogue' AND target_key = 'tcgdex') OR (stage IN ('set_fetch','set_validation','set_import') AND target_type = 'set') OR (stage IN ('card_fetch','card_import') AND target_type = 'card')",
      "name": "import_issues_stage_target_invariant"
    },
    {
      "attribute": [
        "issue_kind",
        "issue_code"
      ],
      "base_filter": null,
      "check": "(issue_kind IN ('unmatched','ambiguous') AND issue_code = 'provider_response') OR (issue_kind = 'malformed' AND issue_code = 'malformed_response') OR (issue_kind = 'failed' AND issue_code IN ('budget','rate_limit','timeout','transport','provider_response','persistence','configuration','local_input','unknown'))",
      "name": "import_issues_kind_code_invariant"
    },
    {
      "attribute": [
        "first_seen_at",
        "last_seen_at"
      ],
      "base_filter": null,
      "check": "last_seen_at >= first_seen_at",
      "name": "import_issues_timestamp_invariant"
    }
