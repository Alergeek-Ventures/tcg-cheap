      "name": "import_issues_provider_invariant"
    },
    {
      "attribute": [
        "operation"
      ],
      "base_filter": null,
      "check": "operation IN ('card_catalogue_sync','card_catalogue_enrichment')",
      "name": "import_issues_operation_invariant"
    },
    {
      "attribute": [
        "stage"
      ],
      "base_filter": null,
      "check": "stage IN ('catalogue_fetch','catalogue_validation','set_fetch','set_validation','set_import','card_fetch','card_import')",
      "name": "import_issues_stage_invariant"
    },
    {
      "attribute": [
        "target_type"
      ],
