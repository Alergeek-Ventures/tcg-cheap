#, elixir-autogen, elixir-format
msgid "%{name} %{number}: od %{price} w sklepach wysyłających do Słowenii."
msgstr "%{name} %{number}: desde %{price} em lojas que enviam para a Eslovénia."

#: lib/tcg_cheap/countries/slovenia.ex:85
#, elixir-autogen, elixir-format
msgid "Angielskie karty Pokémon TCG w sklepach wysyłających do Słowenii."
msgstr "Cartas Pokémon TCG em inglês em lojas que enviam para a Eslovénia."

#: lib/tcg_cheap/countries/slovenia.ex:106
#, elixir-autogen, elixir-format
msgid "Angielskie karty Pokémon TCG w sklepach wysyłających do Słowenii: %{cards} na stanie."
msgstr "Cartas Pokémon TCG em inglês em lojas que enviam para a Eslovénia: %{cards} em stock."

#: lib/tcg_cheap/countries/slovenia.ex:120
#, elixir-autogen, elixir-format
