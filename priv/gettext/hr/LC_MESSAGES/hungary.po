#: lib/tcg_cheap/countries/hungary.ex:99
#, elixir-autogen, elixir-format
msgid "Boostera %{expansion} żaden sklep wysyłający na Węgry nie ma teraz na stanie."
msgstr "%{expansion} booster trenutačno nema na stanju nijedna trgovina koja dostavlja u Mađarsku."

#: lib/tcg_cheap/countries/hungary.ex:62
#, elixir-autogen, elixir-format
msgid "Ceny Pokémon TCG ze sklepów wysyłających na Węgry, sprawdzane codziennie."
msgstr "Cijene Pokémon TCG proizvoda iz trgovina koje dostavljaju u Mađarsku. Provjeravamo ih svaki dan."

#: lib/tcg_cheap/countries/hungary.ex:81
#, elixir-autogen, elixir-format
msgid "Ceny kart Pokémon TCG w forintach"
msgstr "Cijene Pokémon TCG karata u forintama"

#: lib/tcg_cheap/countries/hungary.ex:153
#, elixir-autogen, elixir-format
msgid "Ceny węgierskich sklepów są bez wysyłki, a sklepów z zagranicy – z wysyłką na Węgry. Do Cardmarket doliczamy %{shipping} za paczkę z Niemiec."
msgstr "Cijene mađarskih trgovina su bez dostave, a trgovina iz inozemstva s dostavom u Mađarsku. Cardmarketovoj cijeni dodajemo %{shipping} za paket iz Njemačke."

#: lib/tcg_cheap/countries/hungary.ex:119
#, elixir-autogen, elixir-format
msgid "Ceny ze sklepów z zagranicy są z wysyłką na Węgry."
msgstr "Cijene trgovina iz inozemstva uključuju dostavu u Mađarsku."

#: lib/tcg_cheap/countries/hungary.ex:69
#, elixir-autogen, elixir-format
msgid "Najtańsze oferty Pokémon TCG w sklepach wysyłających na Węgry."
msgstr "Najjeftinije Pokémon TCG ponude u trgovinama koje dostavljaju u Mađarsku."

#: lib/tcg_cheap/countries/hungary.ex:54
#, elixir-autogen, elixir-format
msgid "Porównaj ceny Pokémon TCG w sklepach wysyłających na Węgry. Sprawdź oferty boosterów, ETB i boxów, historię cen i czy warto kupić teraz."
msgstr "Usporedi cijene Pokémon TCG proizvoda u trgovinama koje dostavljaju u Mađarsku. Provjeri ponude boostera, ETB-ova i boxova, povijest cijena i isplati li se kupiti sada."

#: lib/tcg_cheap/countries/hungary.ex:49
#, elixir-autogen, elixir-format
msgid "Przejdź do wersji węgierskiej"
msgstr "Prijeđi na mađarsku verziju"

#: lib/tcg_cheap/countries/hungary.ex:124
#, elixir-autogen, elixir-format
msgid "Sklepy z zagranicy sprzedają w swojej walucie, polskie w złotych. Ich ceny przeliczamy na forinty po dziennych kursach NBP. Strona sklepu może być po polsku albo w innym języku."
msgstr "Trgovine iz inozemstva prodaju u svojoj valuti, a poljske u zlotima. Njihove cijene preračunavamo u forinte po dnevnom tečaju NBP-a. Stranica trgovine može biti na poljskom ili na drugom jeziku."

#: lib/tcg_cheap/countries/hungary.ex:46
#, elixir-autogen, elixir-format
msgid "Wygląda na to, że jesteś na Węgrzech."
msgstr "Izgleda da si u Mađarskoj."

#: lib/tcg_cheap/countries/hungary.ex:43
#, elixir-autogen, elixir-format
msgid "Węgry"
msgstr "Mađarska"

#: lib/tcg_cheap/countries/hungary.ex:17
