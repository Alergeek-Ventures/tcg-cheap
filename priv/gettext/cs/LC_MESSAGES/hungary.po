#: lib/tcg_cheap/countries/hungary.ex:84
#, elixir-autogen, elixir-format
msgid "%{card} – cena karty Pokémon w forintach"
msgstr "%{card} – cena karty Pokémon ve forintech"

#: lib/tcg_cheap/countries/hungary.ex:89
#, elixir-autogen, elixir-format
msgid "%{expansion}: porównaj ceny boosterów, ETB, boxów i kolekcji w sklepach wysyłających na Węgry."
msgstr "%{expansion}: porovnej ceny boosterů, ETB, boxů a kolekcí v obchodech s dopravou do Maďarska."

#: lib/tcg_cheap/countries/hungary.ex:107
#, elixir-autogen, elixir-format
msgid "%{name}: teraz żaden sklep wysyłający na Węgry nie ma tego produktu na stanie."
msgstr "%{name}: tento produkt teď nemá skladem žádný obchod s dopravou do Maďarska."

#: lib/tcg_cheap/countries/hungary.ex:77
#, elixir-autogen, elixir-format
msgid "Angielskie karty Pokémon TCG z ceną z Cardmarket w forintach."
msgstr "Anglické karty Pokémon TCG s cenou z Cardmarket ve forintech."

#: lib/tcg_cheap/countries/hungary.ex:98
#, elixir-autogen, elixir-format
msgid "Boostera %{expansion} żaden sklep wysyłający na Węgry nie ma teraz na stanie."
msgstr "Booster %{expansion} teď nemá skladem žádný obchod s dopravou do Maďarska."

#: lib/tcg_cheap/countries/hungary.ex:61
#, elixir-autogen, elixir-format
msgid "Ceny Pokémon TCG ze sklepów wysyłających na Węgry, sprawdzane codziennie."
msgstr "Ceny Pokémon TCG z obchodů s dopravou do Maďarska, ověřované každý den."

#: lib/tcg_cheap/countries/hungary.ex:80
#, elixir-autogen, elixir-format
msgid "Ceny kart Pokémon TCG w forintach"
msgstr "Ceny karet Pokémon TCG ve forintech"

#: lib/tcg_cheap/countries/hungary.ex:142
#, elixir-autogen, elixir-format
msgid "Ceny węgierskich sklepów są bez wysyłki, a sklepów z zagranicy – z wysyłką na Węgry. Do Cardmarket doliczamy %{shipping} za paczkę z Niemiec."
msgstr "Ceny maďarských obchodů jsou bez dopravy, ceny zahraničních obchodů zahrnují dopravu do Maďarska. K ceně Cardmarket připočítáváme %{shipping} za balík z Německa."

#: lib/tcg_cheap/countries/hungary.ex:118
#, elixir-autogen, elixir-format
msgid "Ceny ze sklepów z zagranicy są z wysyłką na Węgry."
msgstr "Ceny zahraničních obchodů zahrnují dopravu do Maďarska."

#: lib/tcg_cheap/countries/hungary.ex:68
#, elixir-autogen, elixir-format
msgid "Najtańsze oferty Pokémon TCG w sklepach wysyłających na Węgry."
msgstr "Nejlevnější nabídky Pokémon TCG v obchodech s dopravou do Maďarska."

#: lib/tcg_cheap/countries/hungary.ex:53
#, elixir-autogen, elixir-format
msgid "Porównaj ceny Pokémon TCG w sklepach wysyłających na Węgry. Sprawdź oferty boosterów, ETB i boxów, historię cen i czy warto kupić teraz."
msgstr "Porovnej ceny Pokémon TCG v obchodech s dopravou do Maďarska. Podívej se na nabídky boosterů, ETB a boxů, vývoj cen a zjisti, jestli se vyplatí koupit teď."

#: lib/tcg_cheap/countries/hungary.ex:48
#, elixir-autogen, elixir-format
msgid "Przejdź do wersji węgierskiej"
msgstr "Přejít na maďarskou verzi"

#: lib/tcg_cheap/countries/hungary.ex:123
#, elixir-autogen, elixir-format
msgid "Sklepy z zagranicy sprzedają w swojej walucie, polskie w złotych. Ich ceny przeliczamy na forinty po dziennych kursach NBP. Strona sklepu może być po polsku albo w innym języku."
msgstr "Zahraniční obchody prodávají ve své měně, polské v zlotých. Ceny přepočítáváme na forinty denními kurzy NBP. Stránka obchodu může být polsky nebo v jiném jazyce."

#: lib/tcg_cheap/countries/hungary.ex:45
#, elixir-autogen, elixir-format
msgid "Wygląda na to, że jesteś na Węgrzech."
msgstr "Vypadá to, že jsi v Maďarsku."

