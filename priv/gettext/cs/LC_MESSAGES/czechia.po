#: lib/tcg_cheap/countries/czechia.ex:143
#, elixir-autogen, elixir-format
msgid "Ceny czeskich sklepów są bez wysyłki, a sklepów z zagranicy – z wysyłką do Czech. Do Cardmarket doliczamy %{shipping} za paczkę z Niemiec."
msgstr "Ceny českých obchodů jsou bez dopravy, ceny zahraničních obchodů zahrnují dopravu do Česka. K ceně Cardmarket připočítáváme %{shipping} za balík z Německa."

#: lib/tcg_cheap/countries/czechia.ex:81
#, elixir-autogen, elixir-format
msgid "Ceny kart Pokémon TCG w koronach czeskich"
msgstr "Ceny karet Pokémon TCG v korunách"

#: lib/tcg_cheap/countries/czechia.ex:119
#, elixir-autogen, elixir-format
msgid "Ceny ze sklepów z zagranicy są z wysyłką do Czech."
msgstr "Ceny zahraničních obchodů zahrnují dopravu do Česka."

#: lib/tcg_cheap/countries/czechia.ex:42
#, elixir-autogen, elixir-format
