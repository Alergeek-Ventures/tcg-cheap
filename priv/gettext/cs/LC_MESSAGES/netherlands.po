msgid "Ceny bez dostawy, poza oznaczonymi „z wysyłką”, albo trend Cardmarket w euro, co tańsze."
msgstr "Ceny bez dopravy, kromě označených „s dopravou“, nebo trend Cardmarket v eurech, podle toho, co je levnější."

#: lib/tcg_cheap/countries/netherlands.ex:160
