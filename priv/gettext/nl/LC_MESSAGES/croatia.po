msgstr "Engelse Pokémon TCG-kaarten bij winkels die naar Kroatië verzenden: %{cards} op voorraad."

#: lib/tcg_cheap/countries/croatia.ex:123
#, elixir-autogen, elixir-format
msgid "Brak na stanie w chorwackich sklepach"
msgstr "Niet op voorraad bij Kroatische winkels"

#: lib/tcg_cheap/countries/croatia.ex:116
#, elixir-autogen, elixir-format
