# Local development defaults (copy to .env.local; mix dev.up does this for you).
PORT=4004
DB_PORT=5436
BRANCH=main
DATABASE_URL=ecto://postgres:postgres@localhost:5436/tcg_cheap_dev

# One-shot administrator provisioning (`mix admin.provision`). Keep real values
# in your secret manager or untracked .env.local, never in this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional in production; SECRET_KEY_BASE is the secure fallback. If set, the
# value must contain at least 32 bytes.
# ADMIN_AUTH_SIGNING_SECRET=

# Production runtime (inject these from a secret manager; leave empty here).
PHX_HOST=
SECRET_KEY_BASE=
# POOL_SIZE=
# ECTO_IPV6=
# DNS_CLUSTER_QUERY=
