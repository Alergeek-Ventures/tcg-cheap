# Local development defaults (copy to .env.local; mix dev.up does this for you).
PORT=4004
DB_PORT=5436
BRANCH=main
DATABASE_URL=ecto://postgres:postgres@localhost:5436/tcg_cheap_dev
# Replace DATABASE_URL with the production Coolify PostgreSQL URL when deploying.

# One-shot administrator provisioning (`mix admin.provision`). Keep real values
# in your secret manager or untracked .env.local, never in this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional in production; SECRET_KEY_BASE is the secure fallback. If set, the
# value must contain at least 32 bytes. Inject production values from Coolify's
# secret storage rather than copying them into this file.
# ADMIN_AUTH_SIGNING_SECRET=

# Production runtime (inject these from Coolify's secret storage; leave empty
# here). PHX_HOST, DATABASE_URL, and SECRET_KEY_BASE are required in production;
# use the Coolify value for DATABASE_URL instead of this local development URL.
PHX_HOST=
SECRET_KEY_BASE=
# POOL_SIZE=
# ECTO_IPV6=
# DNS_CLUSTER_QUERY=
